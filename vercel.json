{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.savvyhomie.com" }],
      "destination": "https://savvyhomie.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path*.:ext(js|css|png|jpg|webp|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ]
}
